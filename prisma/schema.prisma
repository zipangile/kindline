// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum UserRole {
  DONOR
  VOLUNTEER
  ORG_ADMIN
  SUPERADMIN
}

enum PostType {
  STANDARD
  IMPACT_STORY
}

model Organization {
  id                  String       @id @default(cuid())
  name                String       @default("Kindline Care Foundation")
  tier                PlanTier     @default(STARTER)
  featureOverrides    Json?                  // per-org manual overrides, e.g. {"newsletter": true}
  donationFeePercent  Decimal      @default(2.0)   // 2.0 / 1.5 / 1.0 by tier, editable per-org by superadmin
  volunteerCap        Int?         @default(15)    // 15 / 50 / null(unlimited) by tier
  newsletterSubCap    Int?         @default(0)     // 0 / 500 / null(unlimited) by tier
  volunteerSignupFee  Float        @default(0.0)   // volunteer signup fee (one-time fee)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  role           UserRole @default(DONOR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  orgId     String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  orgId       String    @default("default")
  title       String
  slug        String    @unique
  body        String
  type        PostType  @default(STANDARD)
  featured    Boolean   @default(false)
  image       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Program {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  status      String   @default("live") // "live" or "archived"
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("unread") // unread, read, replied
  createdAt DateTime @default(now())
}

model Communication {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  content   String
  type      String   @default("manual") // manual, reply, system
  sentBy    String?  // admin email or system
  createdAt DateTime @default(now())
}

model ManagedAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String    @default("CONTENT_EDITOR") // SUPER_ADMIN, CONTENT_EDITOR, FINANCIAL_ADMIN, VOLUNTEER_COORD
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  category    String   // e.g., "Event", "Announcement", "Field Update"
  image       String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentSettings {
  id                 String   @id @default(cuid())
  flutterwaveSecret  String?
  flutterwavePublic  String?
  flutterwaveEncrypt String?
  flutterwavePlanZMW String?
  flutterwavePlanUSD String?
  lencoSecret        String?
  lencoPublic        String?
  lencoSignatureKey  String?
  lencoBaseUrl       String   @default("https://sandbox.lenco.co/access/v2/")
  notificationEmail  String?
  updatedAt          DateTime @updatedAt
}

model Donation {
  id            String   @id @default(cuid())
  supabaseUserId String? // Linked to Supabase user for "Friends of Kindline" dashboard
  donorName     String
  donorEmail    String
  amount        Float
  currency      String
  status        String   @default("pending") // pending, successful, failed
  type          String   @default("one-time") // one-time, monthly
  gateway       String
  transactionId String?  @unique
  donorPhone    String?
  feeCharged    Float?   // Platform fee charged
  createdAt     DateTime @default(now())
}

model Volunteer {
  id            String   @id @default(cuid())
  supabaseUserId String? @unique // Linked to Supabase user for dashboard access
  name          String
  email         String
  phone         String?
  skills        String?
  interests     String?
  availability  String?
  experience    String?
  location      String?
  status        String   @default("pending") // pending, approved, rejected
  createdAt     DateTime @default(now())
}

model ImpactStat {
  id          String   @id @default(cuid())
  label       String
  value       String
  description String?
  icon        String?  // Name of the Lucide icon
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'homepage_hero', 'about_community'
  url       String
  alt       String?
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  status         String    @default("active") // "active", "unsubscribed"
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ImpactStory {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // e.g., "Widow Empowerment", "Education Support"
  author      String   // name of the person in the story
  authorRole  String?  // e.g., "WESAP Beneficiary"
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
