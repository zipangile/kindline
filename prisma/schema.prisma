// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Program {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  status      String   @default("live") // "live" or "archived"
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ManagedAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String    @default("CONTENT_EDITOR") // SUPER_ADMIN, CONTENT_EDITOR, FINANCIAL_ADMIN, VOLUNTEER_COORD
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  category    String   // e.g., "Event", "Announcement", "Field Update"
  image       String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentSettings {
  id                 String   @id @default(cuid())
  flutterwaveSecret  String?
  flutterwavePublic  String?
  flutterwaveEncrypt String?
  flutterwavePlanZMW String?
  flutterwavePlanUSD String?
  lencoSecret        String?
  lencoPublic        String?
  lencoSignatureKey  String?
  lencoBaseUrl       String   @default("https://sandbox.lenco.co/access/v2/")
  updatedAt          DateTime @updatedAt
}

model Donation {
  id            String   @id @default(cuid())
  supabaseUserId String? // Linked to Supabase user for "Friends of Kindline" dashboard
  donorName     String
  donorEmail    String
  amount        Float
  currency      String
  status        String   @default("pending") // pending, successful, failed
  type          String   @default("one-time") // one-time, monthly
  gateway       String
  transactionId String?  @unique
  donorPhone    String?
  createdAt     DateTime @default(now())
}

model Volunteer {
  id            String   @id @default(cuid())
  supabaseUserId String? @unique // Linked to Supabase user for dashboard access
  name          String
  email         String
  phone         String?
  skills        String?
  interests     String?
  availability  String?
  experience    String?
  location      String?
  status        String   @default("pending") // pending, approved, rejected
  createdAt     DateTime @default(now())
}

model ImpactStat {
  id          String   @id @default(cuid())
  label       String
  value       String
  description String?
  icon        String?  // Name of the Lucide icon
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'homepage_hero', 'about_community'
  url       String
  alt       String?
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("active") // "active", "unsubscribed"
  createdAt DateTime @default(now())
}

model ImpactStory {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // e.g., "Widow Empowerment", "Education Support"
  author      String   // name of the person in the story
  authorRole  String?  // e.g., "WESAP Beneficiary"
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
